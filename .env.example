# Copy to .env.local. Never commit real credentials.
APP_URL=http://127.0.0.1:3000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dwights_gutters
RESEND_API_KEY=
EMAIL_FROM=Dwight's Gutters <bookings@dwightsgutters.com>
# For local-only captured email: file. Production always uses Resend.
EMAIL_TRANSPORT=resend
# Generate a long random value; schedule POST /api/cron/email/ every 5 minutes.
CRON_SECRET=
# Stripe secret key (sk_live_... in production, sk_test_... for testing). Each invoice gets
# a one-time Stripe payment link for its exact total. Leave blank to keep Stripe off.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...). Add an endpoint in Stripe for
# https://dwightsgutters.com/api/webhooks/stripe/ (keep the trailing slash) listening to
# checkout.session.completed and checkout.session.async_payment_succeeded.
STRIPE_WEBHOOK_SECRET=
